---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
const filename = src.split('/').at(-1) ?? src;

// `src` llega como ruta pública ("/images/blog/<post>/<archivo>"), como se
// escribe en los .mdx. Las imágenes reales viven en src/assets/images/blog
// para que Astro pueda optimizarlas (resize, AVIF, width/height reales).
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/blog/**/*.{png,jpg,jpeg,webp,avif}'
);
const imagePath = `/src/assets/images/blog${src.replace(/^\/images\/blog/, '')}`;
const loadImage = images[imagePath];
if (!loadImage) {
  throw new Error(`Figure: no se encontró la imagen "${imagePath}" (prop src="${src}")`);
}
const { default: image } = await loadImage();
---

<figure class="figure-block">
  <div class="figure-header">
    <span class="figure-title">$ {filename}</span>
  </div>
  <div class="figure-body">
    <Image
      src={image}
      alt={alt}
      width={750}
      format="avif"
      densities={[1, 2]}
      sizes="(max-width: 1024px) 100vw, 750px"
      loading="lazy"
      decoding="async"
    />
  </div>
  {caption && <figcaption class="figure-caption">{caption}</figcaption>}
</figure>

<style>
  .figure-block {
    margin: 2rem 0;
    border: 1px solid var(--color-border);
    font-family: var(--font-body);
  }

  .figure-header {
    padding: 0.4rem 0.75rem;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .figure-title {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .figure-body {
    padding: 1rem;
    background: var(--color-surface);
    text-align: center;
  }

  .figure-body img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
    border: none;
  }

  .figure-caption {
    padding: 0.5rem 0.75rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    margin: 0;
  }
</style>

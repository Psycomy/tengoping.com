---
import BaseLayout from '@layouts/BaseLayout.astro';
import ArticleCard from '@components/ArticleCard.astro';
import HeroSlider from '@components/HeroSlider.astro';
import { getCollection } from 'astro:content';
import { slugify } from '@utils/helpers';
import { categoryMeta } from '@data/categories';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categoryOrder = [
  'Linux',
  'Redes',
  'Seguridad',
  'Self-Hosting',
  'Automatización',
  'Monitorización',
  'Virtualización',
  'Hardware',
  'Software',
  'Opinión',
];

const categoryMap = new Map<string, typeof allPosts>();
for (const post of allPosts) {
  const cat = post.data.category;
  if (!categoryMap.has(cat)) categoryMap.set(cat, []);
  categoryMap.get(cat)!.push(post);
}

const sortedCategories = [...categoryMap.entries()].sort((a, b) => {
  const ia = categoryOrder.indexOf(a[0]);
  const ib = categoryOrder.indexOf(b[0]);
  return (ia === -1 ? 999 : ia) - (ib === -1 ? 999 : ib);
});

const lastUpdated = new Intl.DateTimeFormat('es-ES', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
}).format(allPosts[0].data.pubDate);
---

<BaseLayout isHome={true}>
  <section class="intro container">
    <div class="intro-grid">
      <div class="intro-main">
        <p class="intro-prompt">
          <span class="prompt">$</span> cat bienvenida.md<span class="cursor-blink">_</span>
        </p>
        <h1 class="intro-title">
          Blog técnico de <span class="accent">sysadmin y redes</span>, en español
        </h1>
        <p class="intro-desc">
          Guías prácticas de Linux, redes, seguridad y self-hosting para quien monta o mantiene
          infraestructura — desde un homelab hasta un servidor en producción.
        </p>
      </div>
      <dl class="intro-stats">
        <p class="stats-prompt"><span class="prompt">$</span> stat ./blog</p>
        <div class="stat-row">
          <dt>artículos</dt>
          <dd>{allPosts.length}</dd>
        </div>
        <div class="stat-row">
          <dt>categorías</dt>
          <dd>{sortedCategories.length}</dd>
        </div>
        <div class="stat-row">
          <dt>actualizado</dt>
          <dd>{lastUpdated}</dd>
        </div>
      </dl>
    </div>
  </section>
  <HeroSlider posts={allPosts.slice(0, 5)} />
  {
    sortedCategories.map(([category, posts]) => (
      <section class="category-section container">
        <div class="category-header">
          <h2>
            <span class="category-icon" set:html={categoryMeta[category]?.icon || ''} />
            {category}
          </h2>
          <a
            class="cat-link"
            href={`/categorias/${slugify(category)}`}
            aria-label={`Ver todos los artículos de ${category}`}
          >
            [ver todos →]
          </a>
        </div>
        <div class="category-grid">
          <div class="featured">
            <ArticleCard post={posts[0]} />
          </div>
          {posts.length > 1 && (
            <div class="secondary">
              {posts.slice(1, 3).map((post) => (
                <ArticleCard post={post} />
              ))}
            </div>
          )}
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  .intro {
    padding: 3.5rem 0 2.25rem;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: center;
  }

  .intro-prompt {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin: 0 0 1rem;
  }

  .intro-prompt .prompt {
    color: var(--color-primary);
    font-weight: 700;
    margin-right: 0.4rem;
  }

  .intro-title {
    font-size: 2.5rem;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.01em;
    max-width: 800px;
    margin: 0 0 1.25rem;
  }

  .intro-title .accent {
    color: var(--color-primary);
  }

  .intro-desc {
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 620px;
    margin: 0;
  }

  .intro-stats {
    justify-self: end;
    width: 260px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 1.25rem 1.5rem;
    margin: 0;
  }

  .stats-prompt {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0 0 0.9rem;
  }

  .stats-prompt .prompt {
    color: var(--color-primary);
    font-weight: 700;
    margin-right: 0.4rem;
  }

  .stat-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.5rem 0;
    border-top: 1px solid var(--color-border);
    font-size: 0.8125rem;
  }

  .stat-row:first-of-type {
    border-top: none;
  }

  .stat-row dt {
    color: var(--color-text-secondary);
  }

  .stat-row dd {
    margin: 0;
    font-weight: 700;
    color: var(--color-primary);
    font-size: 0.9375rem;
  }

  @media (max-width: 900px) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .intro-stats {
      justify-self: stretch;
      width: 100%;
      max-width: 340px;
    }
  }

  @media (max-width: 768px) {
    .intro {
      padding: 2rem 0 1.5rem;
    }

    .intro-title {
      font-size: 1.75rem;
    }

    .intro-desc {
      font-size: 0.95rem;
    }
  }

  .category-section {
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--color-border);
    content-visibility: auto;
    contain-intrinsic-size: auto 640px;
  }

  .category-section:last-child {
    border-bottom: none;
  }

  .category-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .category-header h2 {
    margin: 0;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .category-icon {
    display: inline-flex;
    color: var(--color-primary);
  }

  .category-icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .cat-link {
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    text-decoration: none;
    color: var(--color-text-secondary);
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .cat-link:hover {
    color: var(--color-primary);
  }

  .category-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .featured :global(.article-card) {
    flex-direction: column;
  }

  .featured :global(.card-image-link) {
    flex: none;
    aspect-ratio: 16/9;
    min-height: auto;
  }

  .secondary {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .secondary :global(.article-card) {
    flex-direction: row;
    align-items: stretch;
  }

  .secondary :global(.card-image-link) {
    flex: 0 0 140px;
    min-height: auto;
    max-height: none;
  }

  .secondary :global(.card-title) {
    font-size: 0.9375rem;
  }

  .secondary :global(.card-description) {
    display: none;
  }

  .secondary :global(.card-tags) {
    gap: 0.25rem;
  }

  .secondary :global(.card-tags .badge-tag) {
    font-size: 0.6875rem;
    padding: 0.1rem 0.4rem;
  }

  .secondary :global(.badge-category) {
    display: none;
  }

  .secondary :global(.card-content) {
    padding: 0.75rem 1rem;
    gap: 0.5rem;
  }

  .secondary :global(.card-meta) {
    padding-top: 0.5rem;
  }

  @media (max-width: 768px) {
    .category-grid {
      grid-template-columns: 1fr;
    }

    .featured :global(.article-card) {
      flex-direction: column;
    }

    .secondary :global(.card-image-link) {
      flex: 0 0 120px;
      aspect-ratio: 16/9;
      min-height: auto;
    }
  }
</style>
